/* 
Exercise 1: Simple CRUD Application
Create a console-based Employee Management System with:
• Add employee
• View all employees
• Update employee salary
• Delete employee
• Search employee by name
*/


CREATE DATABASE mysql_jdbc_practice;

USE mysql_jdbc_practice;

CREATE TABLE employe(
	empId INT PRIMARY KEY,
    name VARCHAR(150),
    salary DOUBLE
);


1- Add Employe

	INSERT INTO employe(empId, name, salary)
	 VALUES
	 (101, 'keshav yadav', 76700),
	 (102, 'adarsh dwivedi', 99000),
	 (103, 'viru pidhia', 100000),
	 (104, 'abhi yadav', 49000),
	 (105, 'vishu yadav', 64000);
	  
 
 
 2- View All Employees
 
 	SELECT * FROM employe;
 	
Output: 
	
mysql> SELECT * FROM employe;
+-------+------------------+--------+
| empId | name             | salary |
+-------+------------------+--------+
|   101 | keshav yadav     |  76700 |
|   102 | adarsh dwivedi   |  99000 |
|   103 | viru pidhia      |  100000|
|   104 | abhi yadav	   |  49000 |
|   105 | vishu yadav      |  64000 |
+-------+------------------+--------+
5 rows in set (0.00 sec)


3- Update employee salary

	UPDATE employe SET salary=1000
	WHERE empId=101;
	
	output: 
	
+-------+------------------+--------+
| empId | name             | salary |
+-------+------------------+--------+
|   101 | keshav yadav     |  1000  |
|   102 | adarsh dwivedi   |  99000 |
|   103 | viru pidhia      |  100000|
|   104 | abhi yadav	   |  49000 |
|   105 | vishu yadav      |  64000 |
+-------+------------------+--------+
5 rows in set (0.00 sec)


4- Delete employe

	DELETE FROM employe WHERE empId=105;
	
output: 

+-------+------------------+--------+
| empId | name             | salary |
+-------+------------------+--------+
|   101 | keshav yadav     |  1000  |
|   102 | adarsh dwivedi   |  99000 |
|   103 | viru pidhia      |  100000|
|   104 | abhi yadav	   |  49000 |
+-------+------------------+--------+

4 rows in set (0.00 sec)
 	
 	
 	
 5- Search employee by name
 
 		mysql> SELECT * FROM employe
    ->  WHERE name LIKE 'k%';
+-------+------------------+--------+
| empId | name             | salary |
+-------+------------------+--------+
|   101 | keshav yadav     |  1000  |
+-------+------------------+--------+
1 rows in set (0.00 sec)
 	
 	
 	
 	
 	