/*
Module: Visit Management
Purpose:
• Track patient visits
• Store diagnosis and treatment details
*/

USE hospital_management;

--------------------------------------------------
-- Visit Records Table
--------------------------------------------------

CREATE TABLE patient_visits (
    visit_id INT PRIMARY KEY,
    patient_id INT,
    doctor_id INT,
    visit_date DATE,
    diagnosis VARCHAR(100),
    treatment_notes VARCHAR(150)
);

--------------------------------------------------
-- Sample Visit Data
--------------------------------------------------

INSERT INTO patient_visits VALUES
(501, 201, 301, '2026-02-10', 'High Blood Pressure', 'Prescribed BP medication'),
(502, 202, 302, '2026-02-11', 'Knee Pain', 'Physiotherapy advised'),
(503, 203, 303, '2026-02-12', 'Skin Allergy', 'Antihistamine prescribed');

--------------------------------------------------
-- View Visit History
--------------------------------------------------

SELECT visit_id,
       patient_id,
       doctor_id,
       visit_date,
       diagnosis,
       treatment_notes
FROM patient_visits;
